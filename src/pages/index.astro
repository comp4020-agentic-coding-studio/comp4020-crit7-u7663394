---
import { getPlannerData, listMessages } from "../lib/db";
import "../styles.css";

const { courses, sessions, selections } = getPlannerData();
const messages = listMessages();
const selectedIds = new Set(selections.map((row) => row.sessionId));
const planned = sessions.filter((session) => selectedIds.has(session.id));
const days = ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"];
const hours = Array.from({ length: 11 }, (_, i) => i + 8);
const time = (minute: number) => `${String(Math.floor(minute / 60)).padStart(2, "0")}:${String(minute % 60).padStart(2, "0")}`;
const courseFor = (id: number) => courses.find((course) => course.id === id)!;
const query = Astro.url.searchParams;
const feedback = query.get("error") === "clash"
  ? "That time overlaps a class already in your plan. Choose another option."
  : query.has("error") ? "That class option could not be saved." : query.has("saved") ? "Your class choice was saved." : null;
const noteFeedback = query.get("note") === "updated" ? "Note saved." : query.get("note") === "deleted" ? "Note deleted." : query.has("note-error") ? "The note could not be saved. Please try again." : null;
---
<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f5f2eb" />
    <meta name="description" content="Weekform is a visual sample ANU timetable planner. Choose class times, see your week, and keep your plan after a reload." />
    <title>Weekform — an ANU timetable concept</title>
  </head>
  <body>
    <a class="skip-link" href="#planner">Skip to timetable</a>
    <nav class="site-nav" aria-label="Site navigation">
      <a class="wordmark" href="#top" aria-label="Weekform, back to top">WEEK<span>FORM</span><i aria-hidden="true"></i></a>
      <span class="nav-context">ANU timetable concept</span>
      <div class="nav-links"><a href="#experience">Explore courses</a><a href="#planner">Plan your week</a><a href="/readme/">About</a></div>
    </nav>
    <main id="top">
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero-copy">
          <p class="eyebrow"><span class="signal-dot"></span> A new view of your week <span class="eyebrow-index">/ 01</span></p>
          <h1 id="hero-title">Make space for<br /><em>everything.</em></h1>
          <p class="hero-intro">Choose a class time that works. See the whole week at once. Make a plan worth keeping.</p>
          <div class="hero-actions"><a class="button button-dark" href="#planner">Open your timetable <span aria-hidden="true">↗</span></a><a class="text-link" href="#experience">Meet the courses <span aria-hidden="true">↓</span></a></div>
          <p class="hero-footnote">A shared demo plan with four illustrative courses and class times.</p>
        </div>
        <div class="hero-art" aria-hidden="true">
          {courses.map((course, i) => <div class={`hero-poster hero-poster-${i + 1}`}><img src={course.poster} alt="" width="1024" height="1536" /></div>)}
          <div class="hero-orbit"></div><div class="hero-stamp">YOUR WEEK<br />IN VIEW</div>
        </div>
        <div class="hero-side-label" aria-hidden="true">SCROLL TO EXPLORE THE COURSE UNIVERSE — 2026</div>
      </section>
      <section class="section-intro" aria-labelledby="explore-title">
        <p class="eyebrow">Four courses / one coherent week</p>
        <h2 id="explore-title">Every course has<br />a point of view.</h2>
        <p>Scroll through the four studies, then shape their meeting times into one workable plan.</p>
      </section>
      <section class="experience" id="experience" aria-label="Explore the four courses">
        <div class="experience-stage" aria-hidden="true">
          <canvas id="course-canvas"></canvas>
          <div class="stage-fallback"><img src={courses[0].poster} alt="" width="1024" height="1536" /></div>
          <div class="stage-index"><span id="stage-count">01</span><span class="stage-rule"></span>04</div>
        </div>
        <div class="experience-chapters">
          {courses.map((course, i) => <article class="course-chapter" data-course-index={i}>
            <div class="chapter-inner">
              <span class="chapter-number">0{i + 1} / 04 <span>COURSE STUDY</span></span>
              <img class="chapter-mobile-image" src={course.poster} alt={`${course.title} poster artwork`} width="1024" height="1536" loading="lazy" />
              <p class="chapter-code">{course.code}</p>
              <h3>{course.title}</h3>
              <p>{course.description}</p>
              <a href={`#course-${course.id}`}>Choose a time <span aria-hidden="true">↗</span></a>
            </div>
          </article>)}
        </div>
      </section>
      <section class="transition" aria-label="Plan transition"><span>THE COURSES BECOME YOUR WEEK</span><p>From four different worlds to one clear view.</p><a href="#planner" aria-label="Go to timetable">↓</a></section>
      <section class="planner" id="planner" aria-labelledby="planner-title">
        <div class="planner-heading">
          <div><p class="eyebrow"><span class="signal-dot"></span> The working timetable / Semester sample</p><h2 id="planner-title">Your week, composed.</h2><p>Pick one class time for each course. Every change is saved in SQLite and is here when you return.</p></div>
          <div class="plan-summary" aria-label={`${planned.length} of ${courses.length} courses planned`}><strong>{String(planned.length).padStart(2, "0")}<span>/{String(courses.length).padStart(2, "0")}</span></strong><span>COURSES PLANNED</span></div>
        </div>
        <p id="planner-feedback" class:list={["feedback", { "feedback-error": query.has("error") }]} role="status" hidden={!feedback}>{feedback}</p>
        <div class="planner-layout">
          <div class="calendar-area">
            <div class="calendar-toolbar"><span>WEEKLY VIEW <span class="toolbar-spark">✳</span></span><span>{planned.length * 2} HOURS IN CLASS <span class="toolbar-divider">/</span> MON—FRI</span></div>
            <div class="calendar-scroll" role="region" aria-label="Weekly timetable grid" tabindex="0">
              <div class="calendar-grid">
                <div class="time-heading">TIME</div>
                {days.map((day) => <div class="day-heading">{day.slice(0, 3).toUpperCase()} <span>{day}</span></div>)}
                <div class="time-rail">{hours.map((hour) => <span style={`top:${(hour - 8) * 64}px`}>{String(hour).padStart(2, "0")}:00</span>)}</div>
                {days.map((day, dayIndex) => <div class="day-track" role="group" aria-label={day} data-day={dayIndex}>
                  {planned.filter((session) => session.day === dayIndex).map((session) => {
                    const course = courseFor(session.courseId);
                    return <a class={`calendar-event theme-${course.id}`} data-course-id={course.id} href={`#course-${course.id}`} style={`top:${(session.startMinute - 480) / 60 * 64}px;height:${(session.endMinute - session.startMinute) / 60 * 64}px`}>
                      <span class="event-code">{course.code}</span><strong>{course.title}</strong><span class="event-time">{time(session.startMinute)}–{time(session.endMinute)}</span><small class="event-location">{session.location}</small>
                    </a>;
                  })}
                </div>)}
              </div>
            </div>
            <div class="mobile-agenda" aria-label="Timetable by day">
              {days.map((day, dayIndex) => <div class="agenda-day" data-day={dayIndex}>
                <h3>{day}</h3>
                {planned.filter((session) => session.day === dayIndex).length ?
                  planned.filter((session) => session.day === dayIndex).map((session) => {
                    const course = courseFor(session.courseId);
                    return <a class={`agenda-session theme-${course.id}`} data-course-id={course.id} data-start={session.startMinute} href={`#course-${course.id}`}><span class="agenda-time">{time(session.startMinute)}–{time(session.endMinute)}</span><strong>{course.title}</strong><small class="agenda-location">{session.location}</small></a>;
                  }) : <p class="agenda-empty">No classes planned</p>}
              </div>)}
            </div>
          </div>
          <aside class="course-options" aria-labelledby="choices-title">
            <div class="options-header"><span>BUILD YOUR PLAN</span><h3 id="choices-title">Choose class times</h3><p>One meeting per course. Overlapping choices are blocked.</p><p id="plan-live-status" class="inline-status" role="status" aria-live="polite"></p></div>
            {courses.map((course, i) => {
              const options = sessions.filter((session) => session.courseId === course.id);
              const selected = options.find((session) => selectedIds.has(session.id));
              return <details class="course-choice" id={`course-${course.id}`} data-course-id={course.id} open={i === 0}>
                <summary><img src={course.poster} alt="" width="1024" height="1536" loading="lazy" /><span class="choice-heading"><small>{course.code}</small><strong>{course.title}</strong><span class="choice-current">{selected ? `${days[selected.day]} · ${time(selected.startMinute)}` : "Choose a class"}</span></span><span class="choice-toggle" aria-hidden="true">+</span></summary>
                <div class="choice-body">
                  <img class="choice-poster" src={course.poster} alt={`${course.title} poster artwork`} width="1024" height="1536" loading="lazy" />
                  <p>{course.description}</p>
                  <div class="option-list">{options.map((option) => <form method="post" action="/api/plan">
                    <input type="hidden" name="courseId" value={course.id} />
                    <button class:list={["option-button", { selected: selectedIds.has(option.id) }]} type="submit" name="sessionId" value={option.id} aria-pressed={selectedIds.has(option.id)} aria-label={`Save ${course.title}, ${option.label}, ${days[option.day]} ${time(option.startMinute)} to ${time(option.endMinute)}`}>
                      <span class="option-marker" aria-hidden="true"></span><span><strong>{option.label}</strong><small>{days[option.day]} · {time(option.startMinute)}–{time(option.endMinute)}<br />{option.location}</small></span><span class="selected-label">SAVED</span>
                    </button>
                  </form>)}</div>
                </div>
              </details>;
            })}
          </aside>
        </div>
        <p class="sample-disclaimer">This prototype uses illustrative courses, rooms and times. It is not connected to ANU enrolment or the official timetable.</p>
      </section>
      <section class="notes" id="notes" aria-labelledby="notes-title">
        <div class="notes-intro"><p class="eyebrow">A little extra space</p><h2 id="notes-title">Notes for the week.</h2><p>Keep a reminder beside your timetable. Notes are shared in this demo and saved in the same database.</p></div>
        <div class="notes-workspace">
          <form id="note-create-form" method="post" action="/api/messages"><label for="body">Add a note</label><div class="note-input"><input id="body" name="body" required maxlength="500" placeholder="Something to remember…" /><button type="submit">Add note <span aria-hidden="true">↗</span></button></div></form>
          <p id="notes-status" class="note-status" role="status" aria-live="polite">{noteFeedback}</p>
          <p id="notes-empty" class="notes-empty" hidden={messages.length > 0}>No notes yet. Add one above.</p>
          <ul id="messages" aria-label="Saved notes">{messages.map((message) => <li class="note-item" data-note-id={message.id}>
            <details><summary><span class="note-text">{message.body}</span><span class="note-toggle" aria-hidden="true">Edit ↗</span></summary>
              <div class="note-controls">
                <form class="note-update-form" method="post" action="/api/messages"><input type="hidden" name="intent" value="update" /><input type="hidden" name="id" value={message.id} /><label>Note text<textarea name="body" maxlength="500" required>{message.body}</textarea></label><button type="submit">Save changes</button></form>
                <form class="note-delete-form" method="post" action="/api/messages"><input type="hidden" name="intent" value="delete" /><input type="hidden" name="id" value={message.id} /><button type="submit">Delete note</button></form>
              </div>
            </details>
          </li>)}</ul>
          <template id="note-template"><li class="note-item"><details><summary><span class="note-text"></span><span class="note-toggle" aria-hidden="true">Edit ↗</span></summary><div class="note-controls"><form class="note-update-form" method="post" action="/api/messages"><input type="hidden" name="intent" value="update" /><input type="hidden" name="id" /><label>Note text<textarea name="body" maxlength="500" required></textarea></label><button type="submit">Save changes</button></form><form class="note-delete-form" method="post" action="/api/messages"><input type="hidden" name="intent" value="delete" /><input type="hidden" name="id" /><button type="submit">Delete note</button></form></div></details></li></template>
        </div>
      </section>
    </main>
    <footer class="site-footer"><a class="wordmark" href="#top">WEEK<span>FORM</span><i aria-hidden="true"></i></a><span>An independent ANU timetable concept · Built for COMP4020 C7</span><a href="/readme/">How it works ↗</a></footer>
    <script>
      import "../scripts/scene";
      import "../scripts/planner";
      import "../scripts/notes";
    </script>
  </body>
</html>
